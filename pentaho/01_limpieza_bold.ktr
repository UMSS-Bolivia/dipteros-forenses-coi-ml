  <step>
    <name>Solo COI-5P</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Solo con secuencia</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>marker_code</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
