  <step>
    <name>Calcular calidad</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var largo = nuc_limpia.length;
var n_acgt = nuc_limpia.toUpperCase().replace(/[^ACGT]/g, "").length;
var n_no_acgt = largo - n_acgt;
var prop_no_acgt = (largo > 0) ? (n_no_acgt / largo) : 1;
var resultado_calidad = "ok";
if (largo &lt; 500) {
  resultado_calidad = "largo&lt;500";
} else if (prop_no_acgt > 0.01) {
  resultado_calidad = "no_ACGT>1%";
}

var es_formal = (species != null) &amp;&amp; /^[A-Z][a-z]+ [a-z][a-z-]+$/.test(String(species));
var nivel_asignacion = es_formal ? "especie" : "genero";
var especie_formal = es_formal ? String(species) : null;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>largo</name>
        <rename>largo</rename>
        <type>Integer</type>
        <length>9</length>
        <precision>0</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>n_no_acgt</name>
        <rename>n_no_acgt</rename>
        <type>Integer</type>
        <length>9</length>
        <precision>0</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>prop_no_acgt</name>
        <rename>prop_no_acgt</rename>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
